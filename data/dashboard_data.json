  },
  {
   "q": "2",
   "id": "q2",
   "short": "District court outcomes",
   "status": "Answerable descriptively",
   "title": "How do outcomes vary across Quincy, Brookline, Dedham, Stoughton and Wrentham?",
   "summary": "Charge outcomes and the share of case-court pairs with each selected outcome. Rates are unadjusted for case mix, and court can differ across charges in one case."
  },
  {
   "q": "3",
   "id": "q3",
   "short": "Crime mix",
